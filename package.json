{
  "name": "@lab/workspace",
  "version": "0.0.1",
  "private": true,
  "description": "Lab workspace - reusable packages",
  "author": "",
  "license": "MIT",
  "scripts": {
    "build": "pnpm -r build",
    "build:dependencies": "pnpm -r --filter=@lab/core build && pnpm -r --filter=@lab/nft-utils build && pnpm -r --filter=@lab/farcaster-auth build && pnpm -r --filter=@lab/bearbrick-contract build",
    "test": "pnpm -r test",
    "test:contract": "pnpm --filter @lab/bearbrick-contract test",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "format": "prettier --write .",
    "ci": "pnpm install && pnpm lint && pnpm build && pnpm test"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "tsup": "^7.0.0",
    "typescript": "^5.0.0"
  },
  "pnpm": {
    "overrides": {
      "typescript": "^5.0.0"
    }
  }
}
