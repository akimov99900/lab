{
  "version": 2,
  "buildCommand": "cd packages/bearbrick-app && pnpm build",
  "outputDirectory": "packages/bearbrick-app/.next",
  "installCommand": "pnpm install",
  "framework": "nextjs",
  "functions": {
    "packages/bearbrick-app/.next/server/app/**/*.js": {
      "runtime": "nodejs18.x"
    }
  },
  "env": {
    "NEXT_PUBLIC_BASE_RPC_URL": "https://mainnet.base.org"
  }
}